ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local phone testing only: the address phones use to open QR links when the kiosk
# runs on localhost, e.g. your Mac's Wi-Fi IP http://192.168.1.42:3000.
# Ignored on deployed sites (QR codes use the site's own address). Leave unset on Vercel.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
